<script>


/* =========================================================
   GOOGLE SHEET CONFIGURATION
   ========================================================= */


/*
   Your published Google Spreadsheet.
*/

const SPREADSHEET_ID =

"2PACX-1vSlKb4rzKgzr7n-Rx2khlwfOwJrwp-Hq5Csy_yuvzWYEXNWtdcA0XZ_cbvlXBkq8qCqZTLiqJiY7IMV";



/*
   All Google Sheet tabs and their GIDs.
*/

const SHEETS = {


    PRI: {

        name:"PRI",

        gid:"1068845303"

    },


    BDC: {

        name:"BDC",

        gid:"1045311657"

    },


    DDC: {

        name:"DDC",

        gid:"1824127271"

    },


    APDP: {

        name:"APDP",

        gid:"104423786"

    },


    ABDP: {

        name:"ABDP",

        gid:"681492954"

    },


    SANITARY: {

        name:"Sanitary Complex CSC",

        gid:"2071735905"

    },


    COMPOST: {

        name:"Compost Pit",

        gid:"1529761235"

    },


    SOAKAGE: {

        name:"Soakage Pit",

        gid:"1809424720"

    },


    OTHER: {

        name:"Other Deptt",

        gid:"634219296"

    },


    MPLADS: {

        name:"MPLADS",

        gid:"1216189768"

    },


    CDF: {

        name:"CDF",

        gid:"1108715801"

    },


    UT_CAPEX: {

        name:"UT Capex",

        gid:"1467897902"

    }

};



/* =========================================================
   PAGE ELEMENTS
   ========================================================= */

const schemeSelect =
    document.getElementById("scheme");


const searchInput =
    document.getElementById("search");


const tableContainer =
    document.getElementById("tableContainer");


const resultInfo =
    document.getElementById("resultInfo");



/*
   Currently loaded data.
*/

let currentRows = [];

let currentHeaders = [];



/* =========================================================
   CREATE CSV URL
   ========================================================= */

function getCSVUrl(gid) {


    return (

        "https://docs.google.com/spreadsheets/d/e/" +

        SPREADSHEET_ID +

        "/pub?gid=" +

        gid +

        "&single=true&output=csv"

    );

}



/* =========================================================
   CSV PARSER
   ========================================================= */

function parseCSV(text) {


    const rows = [];

    let row = [];

    let cell = "";

    let quoted = false;


    for (
        let i = 0;
        i < text.length;
        i++
    ) {


        const char = text[i];

        const next = text[i + 1];


        /*
           Handle escaped quotation marks.
        */

        if (
            char === '"' &&
            quoted &&
            next === '"'
        ) {

            cell += '"';

            i++;

            continue;

        }


        /*
           Start/end quoted field.
        */

        if (char === '"') {

            quoted = !quoted;

            continue;

        }


        /*
           New CSV cell.
        */

        if (
            char === "," &&
            !quoted
        ) {

            row.push(cell);

            cell = "";

            continue;

        }


        /*
           New CSV row.
        */

        if (
            (char === "\n" ||
             char === "\r") &&
            !quoted
        ) {


            if (
                char === "\r" &&
                next === "\n"
            ) {

                i++;

            }


            row.push(cell);

            cell = "";


            if (
                row.some(
                    value =>
                        String(value).trim() !== ""
                )
            ) {

                rows.push(row);

            }


            row = [];

            continue;

        }


        cell += char;

    }


    /*
       Add final cell.
    */

    if (
        cell !== "" ||
        row.length
    ) {

        row.push(cell);

    }


    if (
        row.some(
            value =>
                String(value).trim() !== ""
        )
    ) {

        rows.push(row);

    }


    return rows;

}



/* =========================================================
   LOAD SELECTED SCHEME
   ========================================================= */

async function loadScheme(scheme) {


    const sheet =
        SHEETS[scheme];


    if (!sheet) {

        return;

    }


    tableContainer.innerHTML = `

        <div class="loading">

            Loading
            <strong>${escapeHTML(sheet.name)}</strong>
            works...

        </div>

    `;


    searchInput.disabled = true;


    try {


        const response =

            await fetch(

                getCSVUrl(sheet.gid),

                {
                    cache:"no-store"
                }

            );


        if (!response.ok) {

            throw new Error(
                "Unable to load Google Sheet."
            );

        }


        const text =
            await response.text();


        const rows =
            parseCSV(text);


        if (!rows.length) {

            throw new Error(
                "No data found."
            );

        }


        /*
           First row = column headings.
        */

        currentHeaders =
            rows[0];


        /*
           Remaining rows = works.
        */

        currentRows =
            rows.slice(1);


        searchInput.disabled = false;


        searchInput.value = "";


        displayTable(
            currentRows
        );


    }


    catch(error) {


        console.error(
            "Google Sheet error:",
            error
        );


        tableContainer.innerHTML = `

            <div class="error">

                Unable to load
                <strong>${escapeHTML(sheet.name)}</strong>
                works.

                <br><br>

                Please check that the Google Sheet
                tab is published and the GID is correct.

            </div>

        `;


        resultInfo.style.display =
            "none";

    }

}



/* =========================================================
   DISPLAY TABLE
   ========================================================= */

function displayTable(rows) {


    if (!rows.length) {


        tableContainer.innerHTML = `

            <div class="loading">

                No works found.

            </div>

        `;


        resultInfo.style.display =
            "block";


        resultInfo.textContent =
            "0 works found";


        return;

    }


    let html =
        "<table>";


    /*
       TABLE HEADER
    */

    html +=
        "<thead><tr>";


    currentHeaders.forEach(
        header => {


            html +=

                `<th>
                    ${escapeHTML(header)}
                 </th>`;

        }
    );


    html +=
        "</tr></thead>";


    /*
       TABLE BODY
    */

    html +=
        "<tbody>";


    rows.forEach(
        row => {


            /*
               Ignore completely empty rows.
            */

            if (
                !row.some(
                    cell =>
                        String(cell).trim() !== ""
                )
            ) {

                return;

            }


            html +=
                "<tr>";


            currentHeaders.forEach(
                (_, index) => {


                    const value =
                        row[index] ?? "";


                    html +=

                        `<td>
                            ${escapeHTML(value)}
                         </td>`;

                }
            );


            html +=
                "</tr>";

        }
    );


    html +=
        "</tbody>";


    html +=
        "</table>";


    tableContainer.innerHTML =
        html;


    resultInfo.style.display =
        "block";


    resultInfo.textContent =

        `${rows.length.toLocaleString("en-IN")}
         works found`;

}



/* =========================================================
   SEARCH WORKS
   ========================================================= */

function searchWorks() {


    const searchText =

        searchInput.value
            .trim()
            .toLowerCase();


    /*
       If search is empty,
       show everything.
    */

    if (!searchText) {

        displayTable(
            currentRows
        );

        return;

    }


    /*
       Search ALL columns.
    */

    const filtered =

        currentRows.filter(
            row =>


                row.some(
                    cell =>


                        String(
                            cell ?? ""
                        )
                        .toLowerCase()
                        .includes(
                            searchText
                        )

                )

        );


    displayTable(
        filtered
    );

}



/* =========================================================
   ESCAPE HTML
   ========================================================= */

function escapeHTML(value) {


    return String(
        value ?? ""
    )

    .replace(
        /&/g,
        "&amp;"
    )

    .replace(
        /</g,
        "&lt;"
    )

    .replace(
        />/g,
        "&gt;"
    )

    .replace(
        /"/g,
        "&quot;"
    )

    .replace(
        /'/g,
        "&#039;"
    );

}



/* =========================================================
   SCHEME SELECTION
   ========================================================= */

schemeSelect.addEventListener(

    "change",

    function() {


        const selectedScheme =
            this.value;


        if (selectedScheme) {


            loadScheme(
                selectedScheme
            );


        }

        else {


            searchInput.disabled =
                true;


            searchInput.value =
                "";


            resultInfo.style.display =
                "none";


            tableContainer.innerHTML = `

                <div class="loading">

                    Select a scheme to
                    view works.

                </div>

            `;

        }

    }

);



/* =========================================================
   SEARCH EVENT
   ========================================================= */

searchInput.addEventListener(

    "input",

    searchWorks

);


</script>


